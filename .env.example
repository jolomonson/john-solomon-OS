# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (the legacy anon key also works: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...)

# Public URL of the app — used in magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): https://jolomonson.mispartechnologies.com

# Comma-separated allowlist. Only these emails can sign in.
ALLOWED_EMAILS=you@example.com

# Server/test only — NEVER prefix with NEXT_PUBLIC. Only needed for `npm run test:db`.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (auth emails go through Supabase SMTP — paste this key into the Supabase
# dashboard's SMTP settings; the app itself doesn't read it).
RESEND_API_KEY=re_...
